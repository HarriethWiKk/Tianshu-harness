engine-strict=true

# better-sqlite3 预编译二进制镜像——让 better-sqlite3 自己的 install 脚本
# (prebuild-install) 也从 npmmirror 拉取，避免国内 GitHub 超时回退 node-gyp
# 编译（Windows 无 VS 时截图里那串报错的根因）。prebuild-install 按包名前缀
# 读取 npm_config_<pkg>_binary_host_mirror（util.js:67-68），只对 better-sqlite3 生效。
better_sqlite3_binary_host_mirror=https://registry.npmmirror.com/-/binary/better-sqlite3
